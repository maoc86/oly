# ============================================================
# Configuración de producción (Docker + Caddy compartido)
# Copiar a `.env.production` y ajustar los valores secretos:
#     cp .env.production.example .env.production
# Levantar con:
#     docker compose --env-file .env.production up -d
# (Las imágenes se publican desde tu máquina; ver deploy/build-push.sh)
# ============================================================

# Dominio público (sin protocolo). Debe resolver por DNS a la IP del VPS.
# Caddy pide el certificado Let's Encrypt y redirige www.olyofficial.com.
DOMAIN=olyofficial.com

# --- Imágenes (construidas y publicadas desde tu máquina) -----
BACKEND_IMAGE=soymanuweb/oly-backend:v1.0.0
FRONTEND_IMAGE=soymanuweb/oly-frontend:v1.0.0

# --- Base de datos (MySQL en contenedor) ---------------------
MYSQL_ROOT_PASSWORD=cambiar-root-secreto
MYSQL_DATABASE=oly_db
MYSQL_USER=oly
MYSQL_PASSWORD=cambiar-password-fuerte

# --- Backend -------------------------------------------------
SECRET_KEY=cambiar-por-un-secreto-de-32-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=https://olyofficial.com
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_WINDOW_SECONDS=60
APP_URL=https://olyofficial.com

# --- SMTP (envío de correos) ---
# SMTP_HOST=smtp.tu-provider.com
# SMTP_PORT=587
# SMTP_USER=no-reply@olyofficial.com
# SMTP_PASSWORD=cambiar-secreto
# SMTP_FROM=
# SMTP_USE_TLS=true

# --- Frontend (inyectado en el build; si cambia, re-construir imagen) ---
NEXT_PUBLIC_API_URL=https://api.olyofficial.com

# --- Backups cifrados ---
BACKUP_PASSPHRASE=cambiar-frase-de-cifrado-larga
BACKUP_KEEP_DAYS=14