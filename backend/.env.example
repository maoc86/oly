DATABASE_URL=mysql+pymysql://oly:oly_pass@localhost:3306/oly_db
SECRET_KEY=oly-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Rate limiting de autenticacion (opcional; estos son los valores por defecto)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_WINDOW_SECONDS=60

# URL pública del frontend (se usa para los links en los correos)
APP_URL=http://localhost:3000

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:3000

# --- SMTP (para enviar correos). Dejar vacío = correos desactivados (solo log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
